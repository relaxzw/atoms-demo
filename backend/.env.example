# 复制本文件为 .env，并填入你的真实密钥
# DeepSeek API Key（在 https://platform.deepseek.com 申请）
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 使用的模型名：deepseek-chat（通用对话，默认）或 deepseek-reasoner（深度推理）
DEEPSEEK_MODEL=deepseek-chat

# DeepSeek API 地址（一般无需修改）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 服务端口（本地运行端口，部署平台可覆盖）
PORT=8000

# 服务商联系电话（用户 Token 余额不足时展示）
SUPPORT_PHONE=15872398796

# 每个用户默认 Token 上限
DEFAULT_TOKEN_LIMIT=100000

# 管理员用户名（注册该用户名即成为管理员，可进入用户管理后台）
ADMIN_USERNAME=admin
